# 小红书去广告 · 个人版规则 (Quantumult X)
# 整理自社区规则 (墨鱼 @ddgksf2013 / fmz200): 已去重、合并脚本规则、去除全部第三方脚本链接
# 用法: 规则粘入 [rewrite_local], https://raw.githubusercontent.com/yunisonly/QuantumultX/main/Scripts/xhs_ads.js 放本地脚本目录, [mitm] 追加 hostname

# ---- 脚本处理 (全部接口合并为一条, 指向本地脚本) ----
^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/(?:note/(?:widgets|feed\?|imagefeed|videofeed\?|tabfeed|redtube\?|comment/list|video/save|live_photo/save)|homefeed(?:\?|/categories)|search/(?:hint|hot_list|trending|notes\?|banner_list)|system_service/(?:splash_config|config\?)) url script-response-body https://raw.githubusercontent.com/yunisonly/QuantumultX/main/Scripts/xhs_ads.js

# ---- 广告/弹窗类接口: 直接拦截 ----
# 惊喜盒子
^https?://edith\.xiaohongshu\.com/api/sns/v\d+/surprisebox/(get_style|open|submit_action) url reject-dict
# 营销盒子触发
^https?://www\.xiaohongshu\.com/api/marketing/box/trigger\? url reject-dict
# 笔记页引导
^https?://edith\.xiaohongshu\.com/api/sns/v\d+/note/guide\? url reject-dict
# 详情流预加载 (含推广)
^https?://edith\.xiaohongshu\.com/api/sns/v\d+/note/detailfeed/preload\? url reject-dict
# 个人页横幅
^https?://edith\.xiaohongshu\.com/api/sns/v\d+/guide/user_banner url reject-dict
# 广告资源 / hey 图库推广
^https?://www\.xiaohongshu\.com/api/sns/(v\d+/ads/resource|v\d+/hey/\w+/hey_gallery) url reject-dict
# 广告接口
^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/(tag/)?ads url reject-200
# 首页引导
^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/guide/home_guide url reject-200
# 开屏 (素材接口, 与脚本的 splash_config 互补)
^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/system_service/splash url reject-200
# 搜索结果页推荐信息
^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/search/notes/recommend_info\? url reject-200

# ---- 原作者附带 (非广告: 隐私/开关类, 默认停用, 需要时去掉行首 #) ----
# ^https?://[a-z]+\.xiaohongshu\.com/api/sns/v\d+/user/teenager/status url reject-200
# ^https?://[a-z]+\.xiaohongshu\.com/api/gslb url reject-200
# ^https?://[a-z]+\.xiaohongshu\.com/api/httpdns url reject-200
# ^https?://[a-z]+\.xiaohongshu\.com/v\d+/stateReport url reject-200
# ^https?://[a-z]+\.xiaohongshu\.com/data/native/matrix_switches url reject-200

hostname = *.xiaohongshu.com
